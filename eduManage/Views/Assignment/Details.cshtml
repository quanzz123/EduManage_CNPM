@model eduManage.Models.Assignment

<div class="container mt-5">
    <h2 class="text-primary">@Model.Title</h2>
    <p><strong>Mô tả:</strong> @Model.Description</p>
    <p><strong>Hạn nộp:</strong> @Model.Deadline?.ToString("dd/MM/yyyy HH:mm")</p>
    @if (!string.IsNullOrEmpty(Model.FileUrl))
    {
        <p>
            <strong>Tệp đính kèm:</strong>
            <a href="@Model.FileUrl" target="_blank" class="text-success">Tải xuống</a>
        </p>
    }
    <a href="@Url.Action("Index")" class="btn btn-secondary mt-3">⬅ Quay lại danh sách</a>
</div>
