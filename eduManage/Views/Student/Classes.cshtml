@{
    ViewData["Title"] = "Lớp học của tôi";
    Layout = "_Layout";
}

<div class="container-fluid py-5">
    <div class="container">
        <div class="row mb-4">
            <div class="col-12">
                <h1 class="display-4 text-primary">Lớp học của tôi</h1>
                <p class="lead">Danh sách các lớp học bạn đang tham gia</p>
            </div>
        </div>

        <div class="row g-4">
            <!-- Sample class cards -->
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Lập trình C#</h5>
                    </div>
                    <div class="card-body">
                        <p class="card-text">Học lập trình C# từ cơ bản đến nâng cao</p>
                        <div class="mb-3">
                            <small class="text-muted">Giảng viên: TS. Nguyễn Văn A</small>
                        </div>
                        <div class="progress mb-3">
                            <div class="progress-bar" style="width: 75%">75%</div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <a href="#" class="btn btn-primary w-100">Vào học</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">ASP.NET Core</h5>
                    </div>
                    <div class="card-body">
                        <p class="card-text">Xây dựng ứng dụng web với ASP.NET Core</p>
                        <div class="mb-3">
                            <small class="text-muted">Giảng viên: ThS. Trần Thị B</small>
                        </div>
                        <div class="progress mb-3">
                            <div class="progress-bar" style="width: 60%">60%</div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <a href="#" class="btn btn-success w-100">Vào học</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">Cơ sở dữ liệu</h5>
                    </div>
                    <div class="card-body">
                        <p class="card-text">Thiết kế và quản trị cơ sở dữ liệu SQL</p>
                        <div class="mb-3">
                            <small class="text-muted">Giảng viên: PGS. Lê Văn C</small>
                        </div>
                        <div class="progress mb-3">
                            <div class="progress-bar" style="width: 90%">90%</div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <a href="#" class="btn btn-info w-100">Vào học</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4 text-end">
            <a href="@Url.Action("Dashboard", "Student")" class="btn btn-outline-secondary">
                Quay lại trang tổng quan
            </a>
        </div>
    </div>
</div>