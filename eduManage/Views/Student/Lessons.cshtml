@model List<eduManage.Models.TblLesson>
@{
    ViewData["Title"] = "Bài học";
    Layout = "_Layout";
    var classInfo = ViewBag.ClassInfo as eduManage.Models.TblClass;
    var studentId = ViewBag.StudentId as int?;
}

<div class="container-fluid py-5">
    <div class="container">
        <h1 class="display-4 text-primary">Bài học</h1>
        <p class="lead">Danh sách bài học trong khóa học: <strong>@classInfo?.ClassName</strong></p>

        <div class="list-group">
            @foreach (var lesson in Model)
            {
                var progress = lesson.TblLearningProgresses?.FirstOrDefault(p => p.UserId == studentId);
                var statusText = "Chưa mở";
                var statusClass = "text-muted";

                if (progress != null)
                {
                    if (progress.IsCompleted.GetValueOrDefault())
                    {
                        statusText = "Đã hoàn thành";
                        statusClass = "text-success";
                    }
                    else if (progress.CompletionRate > 0)
                    {
                        statusText = "Đang học";
                        statusClass = "text-warning";
                    }
                }

                var duration = lesson.TblLessionContents?.Sum(c => c.Duration) ?? 0;

                <a href="@Url.Action("LessonContent", "Student", new { lessonId = lesson.LessonId })" class="list-group-item list-group-item-action">
                    <div class="d-flex w-100 justify-content-between">
                        <h5 class="mb-1">Bài @lesson.OrderIdx: @lesson.Title</h5>
                        <small class="@statusClass">@statusText</small>
                    </div>
                    <p class="mb-1">@lesson.Description</p>
                    <small>Thời lượng: @duration phút</small>
                </a>
            }
        </div>

        <div class="mt-4 text-end">
            <a href="@Url.Action("Dashboard", "Student")" class="btn btn-outline-secondary">
                ⬅️ Quay lại trang tổng quan
            </a>
        </div>
    </div>
</div>
