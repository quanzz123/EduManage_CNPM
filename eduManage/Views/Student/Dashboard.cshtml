@model List<eduManage.Models.TblClass>

@{
    ViewData["Title"] = "Trang sinh viên";
    Layout = "_Layout";
    var studentName = Context.Session.GetString("StudentName");
    var studentId = Context.Session.GetInt32("StudentId");
}

<div class="container-fluid py-5">
    <div class="container">
        <!-- Header Welcome -->
        <div class="row mb-5">
            <div class="col-12">
                <div class="bg-light rounded p-5 text-center">
                    <h1 class="display-4 text-primary mb-3">Xin chào, @studentName!</h1>
                    <p class="fs-5 text-dark">Chào mừng bạn đến với hệ thống quản lý học tập EduManage</p>
                </div>
            </div>
        </div>

        <!-- Hiển thị lỗi nếu có -->
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <!-- Quick Actions -->
        <div class="row mb-5">
            <div class="col-12">
                <h3 class="text-primary mb-4">Truy cập nhanh</h3>
                <div class="row g-4">
                    <div class="col-md-3">
                        <a class="btn btn-primary btn-lg w-100 h-100 d-flex flex-column align-items-center justify-content-center p-4"
                           href="#classes-section">
                            <i class="fas fa-book fa-3x mb-3"></i>
                            <span>Lớp học của tôi</span>
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a class="btn btn-success btn-lg w-100 h-100 d-flex flex-column align-items-center justify-content-center p-4"
                           asp-controller="Assignment" asp-action="Index">
                            <i class="fas fa-tasks fa-3x mb-3"></i>
                            <span>Bài tập</span>
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a class="btn btn-info btn-lg w-100 h-100 d-flex flex-column align-items-center justify-content-center p-4"
                           href="#classes-section">
                            <i class="fas fa-play-circle fa-3x mb-3"></i>
                            <span>Bài học</span>
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a class="btn btn-danger btn-lg w-100 h-100 d-flex flex-column align-items-center justify-content-center p-4"
                            asp-action="Index" asp-controller="Test">
                            <i class="bi bi-pencil-fill fa-3x mb-3"></i>
                            <span>Đánh giá</span>
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a class="btn btn-warning btn-lg w-100 h-100 d-flex flex-column align-items-center justify-content-center p-4"
                           asp-controller="Home" asp-action="Index">
                            <i class="fas fa-home fa-3x mb-3"></i>
                            <span>Trang chủ</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Lớp học của tôi -->
        <div class="row mb-5" id="classes-section">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0"><i class="fas fa-book me-2"></i>Lớp học của tôi</h4>
                    </div>
                    <div class="card-body">
                        @if (Model != null && Model.Count > 0)
                        {
                            <div class="row">
                                @foreach (var classItem in Model)
                                {
                                    <div class="col-md-6 col-lg-4 mb-4">
                                        <div class="card h-100 border-primary">
                                            <div class="card-header bg-light">
                                                <h5 class="card-title mb-0 text-primary">@classItem.ClassName</h5>
                                            </div>
                                            <div class="card-body">
                                                <p class="card-text">@classItem.Description</p>
                                                <p class="card-text">
                                                    <small class="text-muted">
                                                        <strong>Môn:</strong> @classItem.Subject<br>
                                                        <strong>Lịch học:</strong> @classItem.Schedule<br>
                                                        <strong>Giáo viên:</strong>
                                                        @{
                                                            var teacher = ViewBag.Teachers as Dictionary<int, string>;
                                                            if (teacher != null && teacher.ContainsKey(classItem.TeacherId))
                                                            {
                                                                @teacher[classItem.TeacherId]
                                                            }
                                                            else
                                                            {
                                                                <text>Chưa xác định</text>
                                                            }
                                                        }
                                                    </small>
                                                </p>
                                            </div>
                                            <div class="card-footer bg-transparent">
                                                <div class="d-grid gap-2">
                                                    <a href="@Url.Action("Lessons", "Student", new { classId = classItem.ClassId })"
                                                       class="btn btn-primary">
                                                        <i class="fas fa-play-circle me-2"></i>Vào học
                                                    </a>
                                                    <a href="#" class="btn btn-outline-secondary">
                                                        <i class="fas fa-info-circle me-2"></i>Chi tiết
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="fas fa-book-open fa-3x text-muted mb-3"></i>
                                <h5 class="text-muted">Bạn chưa tham gia lớp học nào</h5>
                                <p class="text-muted">Hãy liên hệ với quản trị viên để được thêm vào lớp học.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Thống kê học tập -->
        <div class="row mb-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-info text-white">
                        <h4 class="mb-0"><i class="fas fa-chart-line me-2"></i>Thống kê học tập</h4>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-md-3 mb-3">
                                <div class="border rounded p-3 bg-light">
                                    <h3 class="text-primary">@Model?.Count</h3>
                                    <p class="mb-0">Lớp học</p>
                                </div>
                            </div>
                            <div class="col-md-3 mb-3">
                                <div class="border rounded p-3 bg-light">
                                    <h3 class="text-success">
                                        @{
                                            var totalLessons = Model?.Sum(c =>
                                            ViewBag.LessonCounts != null && ViewBag.LessonCounts.ContainsKey(c.ClassId)
                                            ? ViewBag.LessonCounts[c.ClassId] : 0);
                                        }
                                        @totalLessons
                                    </h3>
                                    <p class="mb-0">Bài học</p>
                                </div>
                            </div>
                            <div class="col-md-3 mb-3">
                                <div class="border rounded p-3 bg-light">
                                    <h3 class="text-warning">0</h3>
                                    <p class="mb-0">Bài tập</p>
                                </div>
                            </div>
                            <div class="col-md-3 mb-3">
                                <div class="border rounded p-3 bg-light">
                                    <h3 class="text-info">0%</h3>
                                    <p class="mb-0">Tiến độ</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Thông báo mới -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h4 class="mb-0"><i class="fas fa-bell me-2"></i>Thông báo mới</h4>
                    </div>
                    <div class="card-body">
                        <div class="list-group list-group-flush">
                            <div class="list-group-item">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1">Chào mừng</h6>
                                    <small>Hôm nay</small>
                                </div>
                                <p class="mb-1">Chào mừng bạn đến với hệ thống EduManage</p>
                            </div>
                            @if (Model != null && Model.Count > 0)
                            {
                                <div class="list-group-item">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">Lớp học mới</h6>
                                        <small>Hôm nay</small>
                                    </div>
                                    <p class="mb-1">Bạn có @Model.Count lớp học đang tham gia</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 15px;
        transition: transform 0.3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
        }

    .btn {
        border-radius: 10px;
        transition: all 0.3s ease;
    }

        .btn:hover {
            transform: scale(1.05);
        }

    .list-group-item {
        border: none;
        border-bottom: 1px solid #eee;
    }

        .list-group-item:last-child {
            border-bottom: none;
        }

    .border-primary {
        border: 2px solid #007bff !important;
    }
</style>