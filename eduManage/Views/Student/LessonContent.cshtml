@model List<eduManage.Models.TblLessionContent>
@{
    var lesson = ViewBag.Lesson as eduManage.Models.TblLesson;
    var progress = ViewBag.Progress as eduManage.Models.TblLearningProgress;
}

<div class="container py-5">
    <div class="mb-4">
        <h2 class="text-primary">@lesson?.Title</h2>
        <p>@Html.Raw(lesson?.Description)</p>

        <div>
            <strong>Tiến độ học:</strong>
            @if (progress != null)
            {
                <span class="badge bg-info me-1">@progress.CompletionRate% hoàn thành</span>
                @if (progress.IsCompleted == true)
                {
                    <span class="badge bg-success">Đã hoàn thành</span>
                }
                else
                {
                    <span class="badge bg-warning">Đang học</span>
                }
            }
            else
            {
                <span class="badge bg-secondary">Chưa bắt đầu</span>
            }
        </div>
    </div>

    <div class="list-group">
        @foreach (var content in Model)
        {
            <div class="list-group-item mb-2">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-1">@content.Title</h5>
                    <span class="badge bg-primary">@content.ContentType</span>
                </div>
                <small class="text-muted">Thời lượng: @content.Duration phút</small>
                <div class="mt-2">
                    <a href="@content.ContentUrl" target="_blank" class="btn btn-outline-primary btn-sm">
                        Xem nội dung
                    </a>
                </div>
            </div>
        }
    </div>

    <div class="mt-4 text-end">
        <a href="@Url.Action("Lessons", "Student", new { classId = lesson?.ClassId })" class="btn btn-outline-secondary">
            Quay lại danh sách bài học
        </a>
    </div>
</div>
