@model eduManage.ViewModels.AttendanceViewModel

<div class="page-wrapper">
	<div class="content container-fluid">
		<div class="page-header">
			<div class="row align-items-center">
				<div class="col">
					<div class="mt-5">
						<h4 class="card-title float-left mt-2">Diểm danh</h4>
					</div>
				</div>
			</div>
		</div>
		<div class="row">
			<div class="col-sm-12">
				<div class="card card-table">
					<div class="card-body booking_card">
						<div class="table-responsive">
                            <form asp-action="Save" method="post">
								<input type="hidden" name="SessionId" value="@Model.SessionId" />
								<input type="hidden" name="classId" value="@Model.classId" />
                                <table class="datatable table table-stripped table table-hover table-center mb-0">
                                    <thead>
                                        <tr>
                                            <th >STT</th>
                                            <th>Tên Học Viên</th>
                                            <th >Trạng Thái</th>
                                            <th >Ghi Chú</th>
                                        </tr>
                                    </thead>
                                    <tbody>
										@for (int i = 0; i < Model.Students.Count; i++)
										{
											<tr>
												<td>@(i + 1)</td>
												<td>@Model.Students[i].FullName</td>
												<td>
													<input type="hidden" name="Students[@i].UserId" value="@Model.Students[i].UserId" />

													<label><input type="radio" name="Students[@i].Status" value="1" @(Model.Students[i].Status == 1 ? "checked" : "") /> Có mặt</label><br />
													<label><input type="radio" name="Students[@i].Status" value="2" @(Model.Students[i].Status == 2 ? "checked" : "") /> Muộn</label><br />
													<label><input type="radio" name="Students[@i].Status" value="3" @(Model.Students[i].Status == 3 ? "checked" : "") /> Vắng phép</label><br />
													<label><input type="radio" name="Students[@i].Status" value="4" @(Model.Students[i].Status == 4 ? "checked" : "") /> Vắng</label>
												</td>
												<td>
													<input type="text" class="form-control" name="Students[@i].Note" value="@Model.Students[i].Note" />
												</td>
											</tr>
										}

                                    </tbody>
                                </table>
                                <div class="submit-section text-center mt-4">
                                    <button type="submit" class="btn btn-primary submit-btn">Lưu Điểm Danh</button>
                                </div>

                            </form>
							
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div id="delete_asset" class="modal fade delete-modal" role="dialog">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content">
				<div class="modal-body text-center">
					<img src="assets/img/sent.png" alt="" width="50" height="46">
					<h3 class="delete_class">Are you sure want to delete this Asset?</h3>
					<div class="m-t-20">
						<a href="#" class="btn btn-white" data-dismiss="modal">Close</a>
						<button type="submit" class="btn btn-danger">Delete</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
