
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@model eduManage.ViewModels.LessonContentVM

<div class="page-wrapper">
    <div class="content container-fluid">
        <div class="page-header">
            <div class="row align-items-center">
                <div class="col">
                    <div class="mt-5">
                        <h4 class="card-title float-left mt-2">Chỉnh sửa bài giảng</h4>
                        <a asp-action="Index" class="btn btn-primary float-right veiwbutton">Trở về</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <form asp-action="Edit" asp-area="admin" asp-controller="LessonContent" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="ContentId" />
                    <input type="hidden" asp-for="LessionId" value="@ViewBag.LessonId" />

                    <div class="row formtype">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Tiêu đề</label>
                                <input class="form-control" type="text" asp-for="Title">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Loại bài giảng</label>
                                <select class="form-control" id="sel1" asp-for="ContentType">
                                    <option value="doc">Tài liệu</option>
                                    <option value="video">Video</option>
                                    
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Upload file(nếu có)</label>
                                <div class="d-flex align-items-center">
                                    <div class="custom-file flex-grow-1">
                                        <input type="file" class="custom-file-input" id="customFile" asp-for="FileUpload">
                                        <label class="custom-file-label" for="customFile">Chọn file</label>
                                    </div>
                                    @if (Model!= null && !string.IsNullOrEmpty(Model.ContentUrl)) {

                                        <a asp-action="Download" asp-route-id="@Model.ContentId" target="_blank" class="btn btn-secondary ml-2" title="Tải tài liệu cũ">
                                        <i class="fa fa-download"></i>
                                    </a>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Thời lượng</label>
                                <input class="form-control" type="text" asp-for="Duration">
                                @if (ViewBag.error != null)
                                {
                                    <span class="text-danger">@ViewBag.error</span>
                                }
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Vị trí</label>
                                <input class="form-control" type="text" asp-for="OrderIdx">
                            </div>
                        </div>
                     
                        
                        
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-12 text-right">
                            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Lưu</button>
                            <a asp-action="Index" asp-route-id="@ViewBag.LessonId" class="btn btn-danger"><i class="fas fa-window-close"></i> Huỷ</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>


