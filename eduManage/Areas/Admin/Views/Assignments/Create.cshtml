@model eduManage.ViewModels.AssignmentVM
@{
    ViewBag.Title = "Create";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml"; 
}
<script src="~/ckeditor/ckeditor.js"></script>
@* <script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script> *@

<div class="page-wrapper">
    <div class="content container-fluid">
        <div class="page-header">
            <div class="row align-items-center">
                <div class="col">
                    <div class="mt-5">
                        <h4 class="card-title float-left mt-2">Thêm mới bài tậpc</h4>
                        <a asp-action="Index" class="btn btn-primary float-right veiwbutton">Trở về</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <form asp-action="Create" asp-area="admin" asp-controller="Assignments" method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>

                    <input type="hidden" asp-for="ClassId" value="@ViewBag.ClassId" />

                    <div class="row formtype">

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Title">Tiêu đề</label>
                                <input class="form-control" type="text" asp-for="Title" />
                                <span asp-validation-for="Title" class="text-danger"></span>
                            </div>
                        </div>

                        @* <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="ClassId">Lớp học</label>
                                <select class="form-control" asp-for="ClassId" asp-items="ViewBag.ClassList">
                                    <option value="">-- Chọn lớp học --</option>
                                </select>
                                <span asp-validation-for="ClassId" class="text-danger"></span>
                            </div>
                        </div> *@

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Deadline">Hạn nộp</label>
                                <input class="form-control" type="date" asp-for="Deadline" />
                                <span asp-validation-for="Deadline" class="text-danger"></span>
                            </div>
                        </div>

                        @* <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Status">Trạng thái</label>
                                <select class="form-control" asp-for="Status">
                                    <option value="Enrolled">Đang học</option>
                                    <option value="Completed">Hoàn thành</option>
                                    <option value="Dropped">Đã rút</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                        </div> *@

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="FileUrl">Uploadfile</label>
                                <input class="form-control" type="text" asp-for="FileUrl" />
                                <span asp-validation-for="FileUrl" class="text-danger"></span>
                            </div>
                        </div>

                        @* <div class="col-md-4"> *@
                        @*     <div class="form-group"> *@
                        @*         <label asp-for="FinalScore">Điểm cuối khóa</label> *@
                        @*         <input class="form-control" type="number" step="0.1" asp-for="FinalScore" /> *@
                        @*         <span asp-validation-for="FinalScore" class="text-danger"></span> *@
                        @*     </div> *@
                        @* </div> *@

                        <div class="col-md-12">
                            <div class="form-group">
                                <label asp-for="Description">Ghi chú</label>
                                <textarea class="form-control" rows="3" asp-for="Description"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                                <script>
                                    CKEDITOR.replace("Description");
                                </script>
                            </div>
                        </div>

                        <div class="col-md-12 mt-3">
                            <button type="submit" class="btn btn-primary">Lưu</button>
                        </div>

                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

