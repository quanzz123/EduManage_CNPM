@model eduManage.ViewModels.SubmissionVM
@{
    ViewBag.Title = "Edit";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
<script src="~/ckeditor/ckeditor.js"></script>
@* <script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script> *@

<div class="page-wrapper">
    <div class="content container-fluid">
        <div class="page-header">
            <div class="row align-items-center">
                <div class="col">
                    <div class="mt-5">
                        <h4 class="card-title float-left mt-2">Chấm bài</h4>
                        <a asp-action="Index" class="btn btn-primary float-right veiwbutton">Trở về</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <form asp-action="Edit" asp-area="admin" asp-controller="Submissions" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="All" class="text-danger"></div>

                    <input type="hidden" asp-for="SubmissionId" />
                    <input type="hidden" asp-for="AssignmentId" />
                    <input type="hidden"  asp-for="StudentId" />


                    <div class="row formtype">

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="StudientName">Họ&tên</label>
                                <input class="form-control" type="text" asp-for="StudientName" readonly/>
                                <span asp-validation-for="StudientName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="SubmitDate">Ngày nộp</label>
                                <input class="form-control" type="text" asp-for="SubmitDate" readonly/>
                                <span asp-validation-for="SubmitDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Score">Điểm</label>
                                <input class="form-control" type="number" asp-for="Score" min="0" max="100" />
                                <span asp-validation-for="Score" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="form-group">
                                <label asp-for="Feedback">Ghi chú</label>
                                <textarea class="form-control" rows="3" asp-for="Feedback"></textarea>
                                <span asp-validation-for="Feedback" class="text-danger"></span>
                                <script>
                                    CKEDITOR.replace("Feedback");
                                </script>
                            </div>
                        </div>

                        <div class="col-md-12 mt-3">
                            <button type="submit" class="btn btn-primary">Lưu</button>
                        </div>

                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


