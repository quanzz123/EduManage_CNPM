@model IEnumerable<eduManage.Models.TblQuiz>

@{
    ViewData["Title"] = "Quản lý bài kiểm tra";
}
<div class="page-wrapper">
    <div class="content container-fluid">

        <div class="container mt-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="bi bi-file-earmark-text"></i> Danh sách bài kiểm tra</h2>
                <a asp-action="Create" asp-route-id="@ViewBag.classId" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Tạo bài kiểm tra mới
                </a>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (Model.Any())
            {
                <div class="row">
                    @foreach (var quiz in Model)
                    {
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="card h-100 shadow-sm">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="card-title mb-0">@quiz.Title</h5>
                                    
                                </div>
                                <div class="card-body">
                                    <p class="card-text text-muted">@quiz.Descriptions</p>
                                    <ul class="list-unstyled">
                                        <li><i class="bi bi-clock"></i> <strong>Thời gian:</strong> @quiz.Duration phút</li>
                                        <li><i class="bi bi-card-checklist"></i> <strong>Số câu hỏi:</strong> @quiz.TblQuestions.Count</li>
                                        @* <li><i class="bi bi-trophy"></i> <strong>Điểm qua:</strong> @quiz.Descriptions%</li> *@
                                    </ul>
                                </div>
                                <div class="card-footer bg-light">
                                    <div class="btn-group w-100" role="group">
                                        <a asp-action="Edit" asp-route-id="@quiz.QuizId"
                                           class="btn btn-sm btn-outline-primary" title="Chỉnh sửa">
                                            <i class="bi bi-pencil"></i> Sửa
                                        </a>
                                        <a asp-action="AddQuestion" asp-route-id="@quiz.QuizId"
                                           class="btn btn-sm btn-outline-success" title="Thêm câu hỏi">
                                            <i class="bi bi-question-circle"></i> Câu hỏi
                                        </a>
                                        <a asp-controller="Exam" asp-action="Start" asp-route-id="@quiz.QuizId"
                                           class="btn btn-sm btn-outline-info" title="Làm bài">
                                            <i class="bi bi-play-circle"></i> Làm bài
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@quiz.QuizId"
                                           class="btn btn-sm btn-outline-danger" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> Chưa có bài kiểm tra nào.
                    <a asp-action="Create" class="alert-link">Tạo bài kiểm tra đầu tiên</a>
                </div>
            }
        </div>
    </div>
</div>