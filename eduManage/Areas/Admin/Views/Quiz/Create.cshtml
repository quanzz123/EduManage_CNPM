@model eduManage.ViewModels.QuizVM
<div class="page-wrapper">
    <div class="content container-fluid">
        <div class="page-header">
            <div class="row align-items-center">
                <div class="col">
                    <h3 class="page-title mt-5">Thêm bài đánh giá</h3> <a asp-action="Index" class="btn btn-primary float-right veiwbutton">Trở về</a>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-12">
                <form method="post" asp-action="Create">
                    <input type="hidden" asp-for="ClassId" value="@ViewBag.classId" />
                    <div class="row formtype">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Tên bài đánh giá</label>
                                <input class="form-control" type="text" asp-for="Title">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Thời gian</label>
                                <input class="form-control" type="text" asp-for="Duration">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Mô tả</label>
                                <textarea class="form-control"  asp-for="Descriptions"></textarea>
                            </div>
                        </div>

                        <div class="col-md-12 mt-3">
                            <button type="submit" class="btn btn-primary">Lưu</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>